{
  "name": "camera-cine",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "copiar": "node -e \"const f=require('fs');f.mkdirSync('www',{recursive:true});f.copyFileSync('index.html','www/index.html')\"",
    "setup:android": "npm run copiar && cap add android && node configurar.js && cap sync android",
    "setup:ios": "npm run copiar && cap add ios && node configurar.js && cap sync ios",
    "sync": "npm run copiar && cap sync",
    "android": "cap open android",
    "ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^6.2.0",
    "@capacitor/android": "^6.2.0",
    "@capacitor/ios": "^6.2.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/share": "^6.0.0",
    "@capacitor-community/media": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0"
  }
}